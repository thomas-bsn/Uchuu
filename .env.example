# Copier en .env (jamais commité) ou passer via l'environnement du conteneur.
# Lu une seule fois au démarrage par BotSettings.from_env (voir docs/configuration.md).
# (requis) = le bot refuse de démarrer sans ; toutes les absentes sont listées d'un coup.

# (requis)
DISCORD_TOKEN=
BOT_PREFIX=$$
BOT_STATUS=Online

# =========================
# SALONS (IDs Discord)
# =========================
# (requis) salon par défaut des images d'historique de match (ancien nom accepté : CHANNEL_LOGS_ID)
CHANNEL_MATCH_HISTORY_ID=

# API interne FastAPI (match history + callbacks Shameless)
# En Docker : 0.0.0.0 (le port n'est publié que sur 127.0.0.1 de l'hôte, derrière le reverse proxy)
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=9000
# (requis) clé de X-Internal-Key, ex. openssl rand -hex 32
INTERNAL_API_KEY=
# IPs du reverse proxy autorisées à poser X-Forwarded-* (lu directement par uvicorn)
FORWARDED_ALLOW_IPS=127.0.0.1

# =========================
# SHAMELESS (une Instance par déploiement)
# =========================
# Secret HMAC des webhooks API -> bot (POST /internal/shameless/webhook)
SHAMELESS_WEBHOOK_SECRET=
# Tolérance d'horloge sur X-Shameless-Timestamp (secondes)
SHAMELESS_WEBHOOK_TOLERANCE_SECONDS=300
# Délai max d'un handler Discord (secondes)
SHAMELESS_HANDLER_TIMEOUT_SECONDS=30
# Lease d'une réservation en cours : passé ce délai, un retry reprend l'event (> timeout handler)
SHAMELESS_CLAIM_LEASE_SECONDS=120
# SQLite locale (dédup webhooks, présences). En Docker : sur le volume /data
SHAMELESS_DB_PATH=data/shameless.sqlite3

# Clé des requêtes authentifiées API -> bot (distincte du secret webhook)
SHAMELESS_BOT_API_KEY=
SHAMELESS_GUILD_ID=
SHAMELESS_TEAM1_VOICE_ID=
SHAMELESS_TEAM2_VOICE_ID=
SHAMELESS_ANNOUNCE_CHANNEL_ID=
SHAMELESS_WEB_URL=

# Dépôt des clips (bot -> API, ADR 0014 de Shameless). Sans l'un des trois premiers, pas de dépôt.
# API : adresse publique + /api derrière le proxy de Shameless ; clé = SHAMELESS_BOT_TO_API_KEY de l'API
SHAMELESS_API_URL=
SHAMELESS_BOT_TO_API_KEY=
SHAMELESS_CLIPS_CHANNEL_ID=
# Taille max d'un clip (octets), égale à celle de l'API (500 Mo)
SHAMELESS_CLIPS_MAX_BYTES=524288000
